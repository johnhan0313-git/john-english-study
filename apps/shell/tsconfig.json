{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "paths": {
      "@sceneenglish/api-client": ["../../packages/api-client/src/index.ts"],
      "@sceneenglish/app-core": ["../../packages/app-core/src/index.ts"],
      "@sceneenglish/app-core/*": ["../../packages/app-core/src/*"]
    }
  },
  "include": ["src"]
}
