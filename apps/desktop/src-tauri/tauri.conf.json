{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SceneEnglish",
  "version": "0.1.0",
  "identifier": "me.cool-app.sceneenglish",
  "build": {
    "beforeDevCommand": "npm run build -w @sceneenglish/shell",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build -w @sceneenglish/shell",
    "frontendDist": "../shell/dist"
  },
  "app": {
    "windows": [
      {
        "title": "SceneEnglish",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
