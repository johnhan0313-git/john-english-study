# 本地测试：连接 john-server（需 Tailscale），与生产 1:1 的 PG + MinIO（-test 后缀）
DATABASE_URL=postgresql+psycopg://english-study:english-study-123@john-server:5432/english-study-test
USE_MIGRATIONS=true

STORAGE_BACKEND=s3
# john-minio 宿主机映射端口为 19000（容器内 9000）
# 若 hostname 报 502，改用 Tailscale IP：http://100.x.x.x:19000
S3_ENDPOINT_URL=http://john-server:19000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=english-study-bucket-test
S3_REGION=us-east-1
S3_USE_SSL=false

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 生产（Portainer + Docker 内网，仅供对照）:
# DATABASE_URL=postgresql+psycopg://english-study:english-study-123@john-postgresql:5432/english-study
# S3_ENDPOINT_URL=http://john-minio:9000
# S3_BUCKET=english-study-bucket

# LLM — scenario generation, writing evaluation (no key = mock)
AI_LLM_BASE_URL=https://api.openai.com/v1
AI_LLM_API_KEY=
AI_LLM_MODEL=gpt-4o-mini

# STT — speaking practice transcription (no key = API returns error)
AI_STT_BASE_URL=https://api.openai.com/v1
AI_STT_API_KEY=
AI_STT_MODEL=whisper-1

# TTS — listening audio (USE_EDGE_TTS=true skips API TTS)
AI_TTS_BASE_URL=https://api.openai.com/v1
AI_TTS_API_KEY=
AI_TTS_MODEL=tts-1
AI_TTS_VOICE=alloy
USE_EDGE_TTS=true

# Example: Groq for LLM + STT, Edge TTS for listening
# AI_LLM_BASE_URL=https://api.groq.com/openai/v1
# AI_LLM_API_KEY=gsk_xxx
# AI_LLM_MODEL=llama-3.3-70b-versatile
# AI_STT_BASE_URL=https://api.groq.com/openai/v1
# AI_STT_API_KEY=gsk_xxx
# AI_STT_MODEL=whisper-large-v3
# USE_EDGE_TTS=true

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Email OTP (SMTP 未配置时验证码写入后端日志)
# 163 邮箱推荐：
#   SMTP_HOST=smtp.163.com
#   SMTP_PORT=465
#   SMTP_USE_TLS=false
#   SMTP_USE_SSL=true
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=false
SMTP_USE_SSL=true
EMAIL_CODE_EXPIRE_MINUTES=10
EMAIL_CODE_COOLDOWN_SECONDS=60
# 开发/测试时在 API 响应中返回验证码（生产务必 false）
AUTH_EXPOSE_CODES=true

# WeChat 网站应用扫码登录
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=http://localhost:8000/api/auth/wechat/callback
FRONTEND_BASE_URL=http://localhost:3000

# Scheduler
DAILY_SCENARIO_HOUR=6
DAILY_SCENARIO_COUNT=3
DEFAULT_DEVICE_ID=default
ENABLE_SCHEDULER=false
# 本地测试库已有数据时设为 true，避免每次重启同步词库（可用 python -m app.cli seed 手动灌库）
SKIP_STARTUP_SEED=true
