DATABASE_URL=sqlite:///./data/app.db
MEDIA_DIR=./data/media
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM — scenario generation, writing evaluation (no key = mock)
AI_LLM_BASE_URL=https://api.openai.com/v1
AI_LLM_API_KEY=
AI_LLM_MODEL=gpt-4o-mini

# STT — speaking practice transcription (no key = API returns error)
AI_STT_BASE_URL=https://api.openai.com/v1
AI_STT_API_KEY=
AI_STT_MODEL=whisper-1

# TTS — listening audio (USE_EDGE_TTS=true skips API TTS)
AI_TTS_BASE_URL=https://api.openai.com/v1
AI_TTS_API_KEY=
AI_TTS_MODEL=tts-1
AI_TTS_VOICE=alloy
USE_EDGE_TTS=true

# Example: Groq for LLM + STT, Edge TTS for listening
# AI_LLM_BASE_URL=https://api.groq.com/openai/v1
# AI_LLM_API_KEY=gsk_xxx
# AI_LLM_MODEL=llama-3.3-70b-versatile
# AI_STT_BASE_URL=https://api.groq.com/openai/v1
# AI_STT_API_KEY=gsk_xxx
# AI_STT_MODEL=whisper-large-v3
# USE_EDGE_TTS=true

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Email OTP (SMTP 未配置时验证码写入后端日志)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
EMAIL_CODE_EXPIRE_MINUTES=10
EMAIL_CODE_COOLDOWN_SECONDS=60
# 开发/测试时在 API 响应中返回验证码（生产务必 false）
AUTH_EXPOSE_CODES=false

# WeChat 网站应用扫码登录
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=http://localhost:8000/api/auth/wechat/callback
FRONTEND_BASE_URL=http://localhost:3000

# Scheduler
DAILY_SCENARIO_HOUR=6
DAILY_SCENARIO_COUNT=3
DEFAULT_DEVICE_ID=default
