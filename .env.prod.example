# 复制到 john-server: ~/apps/john-english-study/.env.prod
# deploy-john-server.sh 会读取此文件注入 docker compose 变量

DATABASE_URL=postgresql+psycopg://english-study:REPLACE_ME@john-postgresql:5432/english-study
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME
S3_BUCKET=english-study-bucket
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2

# LLM — 场景生成、写作评测（必填 AI_LLM_API_KEY，否则使用 Mock）
AI_LLM_BASE_URL=https://api.openai.com/v1
AI_LLM_API_KEY=
AI_LLM_MODEL=gpt-4o-mini

# STT — 口语转写（可选）
# AI_STT_BASE_URL=https://api.openai.com/v1
# AI_STT_API_KEY=
# AI_STT_MODEL=whisper-1

# TTS — 听力音频（默认 Edge TTS，无需 Key）
USE_EDGE_TTS=true

# Groq 示例（LLM + STT 共用同一 Key）:
# AI_LLM_BASE_URL=https://api.groq.com/openai/v1
# AI_LLM_API_KEY=gsk_xxx
# AI_LLM_MODEL=llama-3.3-70b-versatile
# AI_STT_BASE_URL=https://api.groq.com/openai/v1
# AI_STT_API_KEY=gsk_xxx
# AI_STT_MODEL=whisper-large-v3

# john-server：Groq STT 需走宿主机 mihomo（仅 STT，LLM 仍直连 DeepSeek）
AI_STT_HTTP_PROXY=http://host.docker.internal:7890

SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=false
SMTP_USE_SSL=true
